      "time_field": "date",
      "compatibility_status": "template_only",
      "format_version": "wechat-account-day-template.v1",
      "empty_values": [
        "-",
        "--"
      ],
      "metrics": {
        "read_users": [
          "read_users",
          "count",
          "number"
        ],
        "delivered_users": [
          "delivered_users",
          "count",
          "number"
        ],
        "open_rate_percent": [
          "open_rate",
          "percent",
          "percent_text"
        ]
      }
    },
