{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/self-media/cross-platform-fact-consistency-review.v1.schema.json",
  "title": "Cross-platform fact consistency review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_id", "generated_at", "artifact_status",
    "publication_boundary", "content_family_id", "canonical_fact_binding",
    "canonical_claims", "variants", "consistency_status", "release_status",
    "next_gate", "authority", "receipt_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "cross-platform-fact-consistency-review.v1"},
    "review_id": {"type": "string", "pattern": "^cross-platform-facts-[a-f0-9]{24}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifact_status": {"const": "candidate-only"},
    "publication_boundary": {"const": "manual-only"},
    "content_family_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "canonical_fact_binding": {"$ref": "#/$defs/fact_binding"},
    "canonical_claims": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"$ref": "#/$defs/canonical_claim"}
    },
    "variants": {
      "type": "array", "minItems": 2, "maxItems": 20,
      "items": {"$ref": "#/$defs/variant"}
    },
    "consistency_status": {"const": "passed"},
    "release_status": {"const": "review-required"},
    "next_gate": {"const": "platform-packaging-and-human-review"},
    "authority": {
      "const": {"publish_authorized": false, "execution_authorized": false, "external_send_authorized": false}
    },
    "receipt_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repo_ref": {
      "type": "string", "minLength": 1, "maxLength": 500,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fact_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_card_ref", "fact_card_sha256", "revision_id"],
      "properties": {
        "fact_card_ref": {"$ref": "#/$defs/repo_ref"},
        "fact_card_sha256": {"$ref": "#/$defs/sha256"},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "canonical_claim": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "normalized_claim", "normalized_claim_sha256", "required_core"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "normalized_claim": {"type": "string", "minLength": 1, "maxLength": 2000},
        "normalized_claim_sha256": {"$ref": "#/$defs/sha256"},
        "required_core": {"type": "boolean"}
      }
    },
    "variant_claim": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "state", "normalized_claim_sha256", "omission_reason"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "state": {"enum": ["present", "omitted-for-density"]},
        "normalized_claim_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "omission_reason": {
          "oneOf": [{"enum": ["density", "format", "duration"]}, {"type": "null"}]
        }
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "artifact_ref", "artifact_sha256", "fact_binding", "claims"],
      "properties": {
        "platform": {"type": "string", "minLength": 1, "maxLength": 80},
        "artifact_ref": {"$ref": "#/$defs/repo_ref"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "fact_binding": {"$ref": "#/$defs/fact_binding"},
        "claims": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {"$ref": "#/$defs/variant_claim"}
        }
      }
    }
  }
}
