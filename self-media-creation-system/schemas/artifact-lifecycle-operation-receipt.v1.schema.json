{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/self-media/artifact-lifecycle-operation-receipt.v1.schema.json",
  "title": "Artifact lifecycle operation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "operation",
    "status",
    "created_at",
    "manifest_path",
    "manifest_sha256_before",
    "manifest_sha256_after",
    "filesystem_mutation_performed",
    "items",
    "blocked"
  ],
  "properties": {
    "schema_version": {"const": "artifact-lifecycle-operation-receipt.v1"},
    "operation_id": {"type": "string", "minLength": 3},
    "operation": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "blocked", "planned"]},
    "created_at": {"type": "string", "format": "date-time"},
    "manifest_path": {"type": "string", "minLength": 1},
    "manifest_sha256_before": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "manifest_sha256_after": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "filesystem_mutation_performed": {"type": "boolean"},
    "items": {"type": "array", "items": {"type": "object"}},
    "blocked": {"type": "array", "items": {"type": "object"}},
    "metrics": {"type": "object"}
  }
}
