      "result": "invalidate-derived-artifacts"
    },
    {
      "when": "medical or insurance conclusion lacks verified boundary",
      "result": "subject-matter-review-required"
    },
    {
      "when": "customer patient family or child privacy is not cleared",
      "result": "privacy-blocked"
    },
    {
      "when": "asset or quotation rights are unknown",
      "result": "rights-review-required"
    },
    {
      "when": "peer content or comments are used as final fact authority",
      "result": "evidence-needed"
    },
    {
      "when": "external benchmark narrative case claim or customer quote is imported as local fact",
      "result": "evidence-needed"
    },
    {
      "when": "third-party video image music or wording is copied without known rights",
      "result": "rights-review-required"
    },
    {
      "when": "distribution restriction is inferred from low metrics or cross-platform difference alone",
      "result": "evidence-needed"
    },
    {
      "when": "fixed platform threshold or recovery formula lacks current official evidence",
      "result": "candidate-only"
    },
    {
      "when": "routing components come from different contract sets or roots",
      "result": "route-contract-mismatch"
    },
    {
      "when": "an agent treats the canonical routing order as a universal checklist instead of selecting the applicable recipe subset",
      "result": "route-applicability-review-required"
    },
    {
      "when": "a route stage is skipped without an explicit not-applicable reason or applicability is unknown",
      "result": "route-applicability-blocked"
    },
    {
      "when": "verified quote or verified position lacks a reviewed source reference",
      "result": "evidence-needed"
    },
    {
      "when": "framework application or agent inference is phrased as a person's quote or verified position",
      "result": "misattribution-blocked"
    },
    {
      "when": "hook candidate promotes missing data case result or authority into a factual claim",
      "result": "evidence-needed"
    },
    {
      "when": "insurance health high-risk or other serious professional content lacks its applicable translation precheck or frozen-body postcheck",
      "result": "serious-content-translation-review-required"
    },
    {
      "when": "serious content translation receipt body hash or review payload drifts after review",
      "result": "invalidate-serious-content-translation-review"
    },
    {
      "when": "two or more platform adaptations do not share one canonical fact revision and normalized claim ledger",
      "result": "cross-platform-fact-consistency-review-required"
    },
    {
      "when": "a platform adds an undeclared claim changes a normalized claim or omits a core claim for density",
      "result": "cross-platform-fact-drift-blocked"
    },
    {
      "when": "story reveal delays the reason to watch beyond two seconds, uses empty suspense, reveals the complete answer immediately, or does not fulfill its opening",
      "result": "story-reveal-review-required"
    },
    {
      "when": "structure_route is story-arc and story material is incomplete blocked identifiable without authorization or missing its source status",
      "result": "story-material-review-required"
    },
    {
      "when": "structure_route is story-arc and a passed fact-bound story-design-card is missing or drifted",
      "result": "story-design-review-required"
    },
    {
      "when": "story emotion invents internal state or dialogue, exceeds evidence, or turns an individual case into general proof",
      "result": "story-integrity-blocked"
    },
    {
      "when": "integrity evidence privacy causality or medical-insurance boundary fails regardless of attention strength",
      "result": "blocked-no-score-averaging"
    },
    {
      "when": "integrity passes but immediate relevance tension-or-utility progression judgment explanation-budget or packaging alignment fails",
      "result": "return-for-attention-revision"
    },
    {
      "when": "manual route override requests publication external-send or execution authority",
      "result": "prohibited"
    },
    {
      "when": "automatic posting fake engagement circumvention or hidden diversion is requested",
      "result": "prohibited"
    },
