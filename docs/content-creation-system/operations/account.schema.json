{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lightcolor/content-operations/account.schema.json",
  "title": "自媒体账号当前状态对象",
  "description": "保存账号当前定位、经营关系和安全状态；不保存密码、验证码、恢复码或 TOTP 种子。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "account_id",
    "platform",
    "display_name",
    "account_role",
    "status",
    "ownership",
    "security",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "account_id": {
      "type": "string",
      "pattern": "^acct_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "platform": { "type": "string", "minLength": 1, "maxLength": 80 },
    "platform_account_id": { "type": ["string", "null"], "maxLength": 200 },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "account_role": {
      "enum": ["personal-ip", "expertise", "business", "distribution", "experiment", "archive"]
    },
    "status": {
      "enum": ["planning", "active", "paused", "restricted", "recovery", "closed"]
    },
    "goal_ids": {
      "type": "array",
      "description": "优先使用 goal_ ULID；点分 legacy ID 仅为既有对象只读兼容，新的原子经营闭环必须解析到 operating-goal。",
      "items": {
        "type": "string",
        "oneOf": [
          { "pattern": "^goal_[0-9A-HJKMNP-TV-Z]{26}$" },
          { "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" }
        ]
      },
      "uniqueItems": true
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "maxLength": 1000 },
        "audience_segments": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 },
          "uniqueItems": true
        },
        "business_boundary": { "type": "string", "maxLength": 1000 }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "access_model"],
      "properties": {
        "owner_ref": { "type": "string", "minLength": 1, "maxLength": 160 },
        "manager_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 160 },
          "uniqueItems": true
        },
        "access_model": { "enum": ["single-owner", "role-based", "shared-secret", "unknown"] },
        "last_permission_review_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mfa_status", "mfa_method", "recovery_status", "secret_location_class"],
      "properties": {
        "mfa_status": { "enum": ["enabled", "disabled", "unknown"] },
        "mfa_method": { "enum": ["passkey-or-security-key", "authenticator", "sms", "platform-confirmation", "none", "unknown"] },
        "recovery_status": { "enum": ["verified", "unverified", "unknown"] },
        "backup_codes_status": { "enum": ["verified", "generated-not-verified", "not-generated", "not-supported", "unknown"] },
        "secret_location_class": { "enum": ["password-manager", "offline-secure", "platform-only", "not-recorded", "unknown"] },
        "last_security_review_at": { "type": ["string", "null"], "format": "date-time" },
        "last_recovery_drill_at": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    },
    "source_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "evidence_status"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence_status": { "enum": ["user-confirmed", "local-fact", "personal-observation", "official", "unverified"] },
        "note": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
