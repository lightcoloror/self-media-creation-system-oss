  "hard_stops": [
    {
      "when": "factual claim source status is unknown",
      "result": "evidence-needed"
    },
    {
      "when": "research is applicable but no schema-valid ready verified research output exists",
      "result": "research-output-blocked"
    },
    {
      "when": "canonical fact revision is missing or not locked_for_draft",
      "result": "fact-revision-blocked"
    },
    {
