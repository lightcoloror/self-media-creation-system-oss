{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lightcolor/content-operations/interaction-event.schema.json",
  "title": "自媒体去标识化互动事件",
  "description": "追加式记录评论、私信、线下问题、转介绍或无信号观察。只保存去标识化摘要；内容互动不能自动成为客户或 CRM 记录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_classification",
    "interaction_event_id",
    "publication_id",
    "account_id",
    "source_type",
    "occurred_at",
    "recorded_at",
    "deidentified_summary",
    "evidence_status",
    "signal_class",
    "disposition",
    "lead_promotion_status",
    "privacy",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "data_classification": { "enum": ["synthetic-only", "deidentified-operational"] },
    "interaction_event_id": { "type": "string", "pattern": "^int_[0-9A-HJKMNP-TV-Z]{26}$" },
    "publication_id": { "type": "string", "pattern": "^pub_[0-9A-HJKMNP-TV-Z]{26}$" },
    "account_id": { "type": "string", "pattern": "^acct_[0-9A-HJKMNP-TV-Z]{26}$" },
    "source_type": {
      "enum": ["comment", "private-message", "offline-question", "referral", "no-signal", "other"]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "deidentified_summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "question_category": { "type": ["string", "null"], "maxLength": 160 },
    "evidence_status": {
      "enum": ["manual-observation", "local-record", "user-confirmed", "inferred", "unknown"]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "uniqueItems": true
    },
    "signal_class": { "enum": ["content-observation", "business-candidate", "no-signal"] },
    "disposition": { "enum": ["observe-only", "content-input", "lead-candidate", "discard"] },
    "lead_promotion_status": { "enum": ["not-requested", "pending-review", "rejected", "promoted"] },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deidentified", "raw_text_included", "direct_identifiers_included", "retention_class"],
      "properties": {
        "deidentified": { "const": true },
        "raw_text_included": { "const": false },
        "direct_identifiers_included": { "const": false },
        "retention_class": { "enum": ["category-only", "short-summary", "synthetic-only"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_authorized", "contact_authorized", "crm_write_authorized", "publication_authority"],
      "properties": {
        "execution_authorized": { "const": false },
        "contact_authorized": { "const": false },
        "crm_write_authorized": { "const": false },
        "publication_authority": { "const": "never" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "source_type": { "const": "no-signal" } }, "required": ["source_type"] },
      "then": {
        "properties": {
          "signal_class": { "const": "no-signal" },
          "disposition": { "const": "observe-only" },
          "lead_promotion_status": { "const": "not-requested" }
        }
      }
    },
    {
      "if": { "properties": { "disposition": { "const": "lead-candidate" } }, "required": ["disposition"] },
      "then": {
        "properties": {
          "signal_class": { "const": "business-candidate" },
          "lead_promotion_status": { "enum": ["pending-review", "rejected", "promoted"] }
        }
      }
    },
    {
      "if": { "properties": { "lead_promotion_status": { "const": "promoted" } }, "required": ["lead_promotion_status"] },
      "then": {
        "required": ["evidence_refs"],
        "properties": {
          "disposition": { "const": "lead-candidate" },
          "signal_class": { "const": "business-candidate" },
          "evidence_status": { "enum": ["manual-observation", "local-record", "user-confirmed"] },
          "evidence_refs": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
