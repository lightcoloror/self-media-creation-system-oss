{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-media-production-run-lock-verification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "lock_sha256",
    "status",
    "verified_file_count",
    "automatic_publish"
  ],
  "properties": {
    "schema_version": {"const": "self-media-production-run-lock-verification.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "passed"},
    "verified_file_count": {"type": "integer", "minimum": 1},
    "automatic_publish": {"const": false}
  }
}
