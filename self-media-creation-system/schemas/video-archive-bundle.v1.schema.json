{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "topic_title", "video_title", "workspace_root", "assets", "restore_limits"],
  "properties": {
    "schema_version": {"const": "self-media.archive-bundle.v1"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"},
    "topic_title": {"type": "string", "minLength": 1},
    "video_title": {"type": "string", "minLength": 1},
    "workspace_root": {"type": "string", "minLength": 1},
    "restore_limits": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "protected_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assets": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["asset_id", "path", "role"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["raw_source", "fine_cut", "final", "cover", "recipe", "subtitle", "audio", "effect", "approval", "reference", "intermediate_master", "cache", "dependency_link"]},
          "include": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1},
          "expected_edit": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
