{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "script_ref",
    "edited_media",
    "context_manifest_ref",
    "timeline_sha256",
    "areas",
    "cues",
    "feedback_dispositions",
    "pacing"
  ],
  "properties": {
    "schema": {
      "const": "self-media.performance-plan.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "script_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "edited_media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "context_manifest_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "timeline_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "areas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speech_boundaries",
        "speech_levels",
        "music_balance",
        "subtitle_readability",
        "visual_focus",
        "delivery_pacing"
      ],
      "properties": {
        "speech_boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reason",
            "cue_ids"
          ],
          "properties": {
            "decision": {
              "enum": [
                "undecided",
                "use",
                "not_needed"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "cue_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "speech_levels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reason",
            "cue_ids"
          ],
          "properties": {
            "decision": {
              "enum": [
                "undecided",
                "use",
                "not_needed"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "cue_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "music_balance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reason",
            "cue_ids"
          ],
          "properties": {
            "decision": {
              "enum": [
                "undecided",
                "use",
                "not_needed"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "cue_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "subtitle_readability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reason",
            "cue_ids"
          ],
          "properties": {
            "decision": {
              "enum": [
                "undecided",
                "use",
                "not_needed"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "cue_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "visual_focus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reason",
            "cue_ids"
          ],
          "properties": {
            "decision": {
              "enum": [
                "undecided",
                "use",
                "not_needed"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "cue_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "delivery_pacing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reason",
            "cue_ids"
          ],
          "properties": {
            "decision": {
              "enum": [
                "undecided",
                "use",
                "not_needed"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "cue_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "kind",
          "quote",
          "start_seconds",
          "end_seconds",
          "intent",
          "decision",
          "reason",
          "expected_result",
          "scope",
          "source_ref",
          "source_quote",
          "requires_change",
          "before_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "enum": [
              "speech_boundaries",
              "speech_levels",
              "music_balance",
              "subtitle_readability",
              "visual_focus",
              "delivery_pacing"
            ]
          },
          "kind": {
            "enum": [
              "emphasis",
              "pause",
              "evidence",
              "reaction",
              "cut",
              "audio",
              "subtitle",
              "layout",
              "pacing"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "source_quote": {
            "type": "string",
            "minLength": 1
          },
          "requires_change": {
            "type": "boolean"
          },
          "before_ref": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "beat_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "feedback_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_ref",
          "decision",
          "reason",
          "cue_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "decision": {
            "enum": [
              "applied",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "cue_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "next_trial_speed",
        "observations"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_tested",
            "provisional_observations"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "next_trial_speed": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "media_ref",
              "evidence_ref",
              "reviewer_id",
              "reviewer_kind",
              "audience_fit",
              "familiarity",
              "speed",
              "start_seconds",
              "end_seconds",
              "first_exposure",
              "comfort",
              "skip_at_seconds",
              "gist_response",
              "gist_correct",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "media_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "evidence_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "reviewer_kind": {
                "enum": [
                  "author",
                  "peer",
                  "target_viewer"
                ]
              },
              "audience_fit": {
                "type": "string",
                "minLength": 1
              },
              "familiarity": {
                "type": "string",
                "minLength": 1
              },
              "speed": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 4
              },
              "start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "end_seconds": {
                "type": "number",
                "minimum": 0
              },
              "first_exposure": {
                "type": "boolean"
              },
              "comfort": {
                "enum": [
                  "slow",
                  "comfortable",
                  "rushed",
                  "unknown"
                ]
              },
              "skip_at_seconds": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "gist_response": {
                "type": "string",
                "minLength": 1
              },
              "gist_correct": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "visual_beats_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Current execution records, not automatic perceptual quality or audience validation. No route selection."
}
