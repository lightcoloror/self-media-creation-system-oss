{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/self-media/case-financial-facts.v1.schema.json",
  "title": "Case financial facts with explicit amount semantics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "case_ref",
    "updated_at",
    "verification_owner",
    "facts"
  ],
  "properties": {
    "schema_version": {"const": "self-media-case-financial-facts.v1"},
    "ledger_id": {"$ref": "#/$defs/id"},
    "case_ref": {"$ref": "#/$defs/id"},
    "updated_at": {"type": "string", "format": "date-time"},
    "verification_owner": {"type": "string", "minLength": 1, "maxLength": 120},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fact"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,99}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_sha256", "evidence_kind"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_kind": {
          "enum": [
            "invoice",
            "fee_detail",
            "payment_record",
            "claim_notice",
            "bank_record",
            "loan_record",
            "user_confirmation",
            "other"
          ]
        }
      }
    },
    "publicWording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "precision", "lower_bound", "upper_bound_exclusive"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 80},
        "precision": {"enum": ["exact", "approximate"]},
        "lower_bound": {"type": "number", "minimum": 0},
        "upper_bound_exclusive": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "stage",
        "scope",
        "amount_role",
        "currency",
        "exact_amount",
        "evidence_status",
        "source_refs",
        "related_fact_refs",
        "public_wording"
      ],
      "properties": {
        "fact_id": {"$ref": "#/$defs/id"},
        "stage": {"type": "string", "minLength": 1, "maxLength": 120},
        "scope": {
          "enum": [
            "charge_item",
            "hospital_encounter",
            "treatment_stage",
            "insurance_claim",
            "cashflow",
            "borrowing"
          ]
        },
        "amount_role": {
          "enum": [
            "charge_item",
            "encounter_total",
            "actual_payment",
            "reimbursement",
            "cash_required",
            "borrowed_principal",
            "repaid_principal"
          ]
        },
        "currency": {"const": "CNY"},
        "exact_amount": {"type": "number", "minimum": 0},
        "evidence_status": {
          "enum": ["document_verified", "user_confirmed", "document_and_user_verified", "unknown"]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "related_fact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "public_wording": {
          "oneOf": [{"$ref": "#/$defs/publicWording"}, {"type": "null"}]
        },
        "notes": {"type": "string", "maxLength": 500}
      }
    }
  }
}
