{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/self-media/platform-publication-package.v1.schema.json",
  "title": "Manual-only multi-platform publication package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "content_item_ref",
    "created_at",
    "video",
    "automatic_publish",
    "publication_mode",
    "platforms"
  ],
  "properties": {
    "schema_version": {"const": "self-media-platform-publication-package.v1"},
    "package_id": {"$ref": "#/$defs/id"},
    "content_item_ref": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "video": {"$ref": "#/$defs/artifact"},
    "automatic_publish": {"const": false},
    "publication_mode": {"const": "manual_only"},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/platform"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,99}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "expected_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio", "artifact"],
      "properties": {
        "ratio": {"enum": ["9:16", "3:4", "4:3", "16:9", "1:1"]},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_status",
        "checked_at",
        "title_max_characters",
        "short_title_max_characters",
        "collection_name_max_characters",
        "collection_description_max_characters",
        "required_cover_ratios",
        "minimum_cover_candidates",
        "maximum_cover_candidates",
        "collection_cover_required",
        "required_collection_cover_ratios",
        "minimum_schedule_lead_minutes"
      ],
      "properties": {
        "source_status": {
          "enum": ["user_confirmed_current_authenticated_ui", "official_documentation", "unknown"]
        },
        "checked_at": {"type": "string", "format": "date-time"},
        "title_max_characters": {"type": ["integer", "null"], "minimum": 1},
        "short_title_max_characters": {"type": ["integer", "null"], "minimum": 1},
        "collection_name_max_characters": {"type": ["integer", "null"], "minimum": 1},
        "collection_description_max_characters": {"type": ["integer", "null"], "minimum": 1},
        "required_cover_ratios": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["9:16", "3:4", "4:3", "16:9", "1:1"]}
        },
        "minimum_cover_candidates": {"type": "integer", "minimum": 1},
        "maximum_cover_candidates": {"type": ["integer", "null"], "minimum": 1},
        "collection_cover_required": {"type": "boolean"},
        "required_collection_cover_ratios": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["9:16", "3:4", "4:3", "16:9", "1:1"]}
        },
        "minimum_schedule_lead_minutes": {"type": ["integer", "null"], "minimum": 0}
        ,
        "maximum_schedule_lead_minutes": {"type": ["integer", "null"], "minimum": 0},
        "schedule_change_policy": {
          "enum": ["modifiable", "unmodifiable", "restricted_by_submission_type", "unknown_must_recheck"]
        },
        "schedule_change_route": {"type": ["string", "null"], "minLength": 1},
        "schedule_restricted_submission_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "collection_creation_during_publish_supported": {"type": ["boolean", "null"]},
        "attach_during_publish_requires_existing_collection": {"type": ["boolean", "null"]},
        "post_publish_add_to_collection_supported": {"type": ["boolean", "null"]},
        "temporary_title_field_tag_recognition": {"type": "boolean"},
        "final_title_restore_required": {"type": "boolean"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_id",
        "enabled",
        "title",
        "short_title",
        "description",
        "tags",
        "collection_name",
        "collection_description",
        "collection_cover",
        "scheduled_at",
        "covers",
        "rules",
        "human_preview_status",
        "copy_human_review_status"
      ],
      "properties": {
        "platform_id": {
          "enum": ["xiaohongshu", "wechat_channels", "bilibili", "douyin", "kuaishou", "other"]
        },
        "enabled": {"type": "boolean"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "short_title": {"type": ["string", "null"], "maxLength": 100},
        "description": {"type": "string", "minLength": 1, "maxLength": 5000},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "collection_name": {"type": ["string", "null"], "maxLength": 100},
        "collection_description": {"type": ["string", "null"], "maxLength": 1000},
        "collection_cover": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/cover"}
          ]
        },
        "scheduled_at": {"type": ["string", "null"], "format": "date-time"},
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/cover"}
        },
        "rules": {"$ref": "#/$defs/rules"},
        "human_preview_status": {"enum": ["pending", "passed", "rework_required"]},
        "copy_human_review_status": {"enum": ["pending", "passed", "rework_required"]}
      }
    }
  }
}
