{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-media-production-run-lock-spec.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "recipe_id", "lock_scope", "components", "rule_files"],
  "properties": {
    "schema_version": {"const": "self-media-production-run-lock-spec.v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{5,120}$"},
    "recipe_id": {"type": "string", "minLength": 1},
    "lock_scope": {"const": "toolchain-and-static-rules-only"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "owner_root", "entrypoints"],
        "properties": {
          "tool_id": {"type": "string", "minLength": 1},
          "owner_root": {"type": "string", "minLength": 1},
          "entrypoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "rule_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
