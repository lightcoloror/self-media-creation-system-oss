{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-media-production-run-lock.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "recipe_id",
    "lock_scope",
    "created_at",
    "components",
    "rule_files",
    "drift_policy",
    "authority_boundary",
    "lock_sha256"
  ],
  "properties": {
    "schema_version": {"const": "self-media-production-run-lock.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "recipe_id": {"type": "string", "minLength": 1},
    "lock_scope": {"const": "toolchain-and-static-rules-only"},
    "created_at": {"type": "string", "format": "date-time"},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "rule_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "drift_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_any_hash_change", "active_run_can_absorb_code_changes"],
      "properties": {
        "on_any_hash_change": {"const": "invalidate-downstream-candidates-and-start-new-run"},
        "active_run_can_absorb_code_changes": {"const": false}
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_only", "candidate_only", "upload_allowed", "publish_allowed"],
      "properties": {
        "local_only": {"const": true},
        "candidate_only": {"const": true},
        "upload_allowed": {"const": false},
        "publish_allowed": {"const": false}
      }
    },
    "lock_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "owner_root", "source_commit", "worktree_state", "entrypoints"],
      "properties": {
        "tool_id": {"type": "string", "minLength": 1},
        "owner_root": {"type": "string", "minLength": 1},
        "source_commit": {"type": ["string", "null"]},
        "worktree_state": {"enum": ["clean", "dirty", "unversioned"]},
        "entrypoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
      }
    }
  }
}
