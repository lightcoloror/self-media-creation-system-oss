{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.lightcolor/small-model-content-loop-input.v1.schema.json",
  "title": "Small model evidence-to-content candidate loop input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic_only",
    "fixture_time",
    "content_id",
    "topic",
    "audience",
    "requested_final_state",
    "contract_binding",
    "evidence_bundle",
    "claim_units",
    "canonical_seed",
    "human_voice_attestation"
  ],
  "properties": {
    "schema_version": {"const": "small-model-content-loop-input.v1"},
    "synthetic_only": {"const": true},
    "fixture_time": {"type": "string", "format": "date-time"},
    "closure_run_id": {"type": "string", "pattern": "^smcl-[a-z0-9-]{8,64}$"},
    "content_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,79}$"},
    "topic": {"type": "string", "minLength": 4},
    "audience": {"type": "string", "minLength": 3},
    "requested_final_state": {"enum": ["candidate", "review_required", "final", "finalized", "published", "publish-ready", "release-ready"]},
    "contract_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing_contract_version", "routing_set_sha256", "content_item_schema_sha256", "human_voice_skill_sha256", "human_voice_rulebook_sha256"],
      "properties": {
        "routing_contract_version": {"const": "1.7.0"},
        "routing_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "content_item_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "human_voice_skill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "human_voice_rulebook_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facade_contract", "native_contract", "research_id", "path", "sha256"],
      "properties": {
        "facade_contract": {"const": "evidence-bundle.v1"},
        "native_contract": {"const": "research-output.v1"},
        "research_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "claim_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "text", "fact_status", "evidence_ids"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "fact_status": {"enum": ["verified_source", "verified_position", "framework_application", "agent_inference", "unverified"]},
          "claim_id": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "framework_ref": {"type": "string"},
          "position_confirmed": {"type": "boolean"},
          "human_review_required": {"type": "boolean"}
        }
      }
    },
    "canonical_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "opening", "summary", "boundary", "sections"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "opening": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading", "body", "claim_unit_ids"],
            "properties": {
              "heading": {"type": "string", "minLength": 1},
              "body": {"type": "string", "minLength": 1},
              "claim_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "human_voice_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "body_sha256", "read_aloud_completed", "author_voice_confirmed"],
      "properties": {
        "mode": {"const": "synthetic_fixture_attestation"},
        "body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "read_aloud_completed": {"type": "boolean"},
        "author_voice_confirmed": {"type": "boolean"}
      }
    }
  }
}
