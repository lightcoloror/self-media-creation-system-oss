{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current creative task assessment supplied by the Agent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "revision_id", "task_kind", "topic_domain", "primary_intent", "requested_route", "requested_vlog_style", "material_state", "material_summary", "assessment_reason", "avoid_forced_story", "causal_change", "source_refs"],
  "properties": {
    "schema_version": {"const": "creation-route-context.v1"},
    "task_id": {"type": "string", "minLength": 6},
    "revision_id": {"type": "string", "minLength": 1},
    "task_kind": {"enum": ["create", "rewrite", "replan", "technical-rework"]},
    "topic_domain": {"enum": ["travel-experience", "case", "explanation", "other", "unknown"]},
    "primary_intent": {"enum": ["preserve-experience", "activity-highlights", "practical-guide", "compare-experiences", "sensory-place", "observe-people-place", "causal-change", "explain-or-answer", "unknown"]},
    "requested_route": {"enum": ["auto", "story", "travel-experience", "expository"]},
    "requested_vlog_style": {"enum": ["auto", "chronological-diary", "activity-highlights", "practical-guide", "experience-review", "atmospheric-montage", "observational"]},
    "material_state": {"enum": ["existing", "planned", "mixed", "unknown"]},
    "material_summary": {"type": "string", "minLength": 1},
    "assessment_reason": {"type": "string", "minLength": 1},
    "avoid_forced_story": {"type": "boolean"},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "causal_change": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {"enum": ["supported", "absent", "unknown"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "supported"}}}, "then": {"properties": {"evidence_refs": {"minItems": 1}}}}]
    }
  }
}
