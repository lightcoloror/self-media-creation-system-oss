{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/self-media/self-media-step-output-receipt.v1.schema.json",
  "title": "Existing owner output receipt bound to one self-media step handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "handoff", "step_id", "tool_id", "output_contract", "outputs", "boundaries", "payload_sha256"],
  "properties": {
    "schema_version": {"const": "self-media-step-output-receipt.v1"},
    "status": {"enum": ["candidate_ready", "human_gate_recorded", "blocked"]},
    "handoff": {"$ref": "#/$defs/artifact"},
    "step_id": {"type": "string"},
    "tool_id": {"type": "string"},
    "output_contract": {"type": "string"},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "boundaries": {"type": "object"},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
