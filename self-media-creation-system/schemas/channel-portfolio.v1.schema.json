{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.self-media/schemas/channel-portfolio.v1.schema.json",
  "title": "Channel portfolio v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strategy_id", "updated_at", "status", "publication_boundary", "current_stage", "principles", "channels", "format_decision_rules", "ip_routes", "weekly_core_unit", "feedback_policy", "expansion_gates", "source_refs"],
  "properties": {
    "schema_version": {"const": "channel-portfolio.v1"},
    "strategy_id": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active-user-approved", "superseded"]},
    "publication_boundary": {"const": "manual-only"},
    "current_stage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "default_public_format", "default_public_platform", "video_cadence", "longform_cadence", "distribution_mode", "synchronized_public_platforms"],
      "properties": {
        "id": {"const": "single-frozen-master-synchronized-distribution-validation"},
        "label": {"type": "string", "minLength": 1},
        "default_public_format": {"const": "short-video-narration"},
        "default_public_platform": {"const": "xiaohongshu"},
        "video_cadence": {"type": "string", "minLength": 1},
        "longform_cadence": {"type": "string", "minLength": 1},
        "distribution_mode": {"const": "manual-synchronized-frozen-master"},
        "synchronized_public_platforms": {
          "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["xiaohongshu", "wechat-video", "douyin", "kuaishou", "bilibili"]}
        }
      }
    },
    "principles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "channels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/channel"}},
    "format_decision_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/formatRule"}},
    "ip_routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ipRoute"}},
    "weekly_core_unit": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "default_outputs", "public_adaptation_max", "public_adaptation_max_scope", "same-copy-cross-posting"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "default_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "public_adaptation_max": {"type": "integer", "minimum": 1, "maximum": 2},
        "public_adaptation_max_scope": {"const": "distinct-platform-variants-only-excludes-identical-frozen-master-sync"},
        "same-copy-cross-posting": {"const": "manual-synchronized-frozen-master"}
      }
    },
    "feedback_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["moments_no_signal", "content_signal", "business_signal", "private_feedback_gate"],
      "properties": {
        "moments_no_signal": {"const": "neutral-insufficient-evidence"},
        "content_signal": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "business_signal": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "private_feedback_gate": {"const": "helpful-not-required"}
      }
    },
    "expansion_gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["target", "when"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "source_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref", "status", "supports"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "status": {"enum": ["user-confirmed", "published-local-evidence", "local-system-contract", "official-source", "industry-experience-candidate"]},
          "supports": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "priority", "current_distribution_status", "portfolio_role", "account_ips", "primary_formats", "overlay_ref", "current_action", "not_for", "acquisition_runtime"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2", "pause", "service-only", "observe"]},
        "current_distribution_status": {"enum": ["active-synchronized-master", "selective", "private-only", "not-active"]},
        "portfolio_role": {"type": "string", "minLength": 1},
        "account_ips": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "primary_formats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "overlay_ref": {"type": "string", "minLength": 1},
        "current_action": {"type": "string", "minLength": 1},
        "not_for": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "acquisition_runtime": {"$ref": "#/$defs/acquisitionRuntime"}
      }
    },
    "acquisitionRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquisition_mode", "runtime_status", "execution_authority", "account_access", "real_media_download", "boundary_note", "evidence_ref"],
      "properties": {
        "acquisition_mode": {"enum": ["manual-private-input", "public-readonly-tools", "share-link-assisted", "general-web-best-effort", "overlay-only"]},
        "runtime_status": {"enum": ["manual-only", "available-with-boundaries", "synthetic-verified-real-runtime-pending", "best-effort-no-native-sampler", "not-verified"]},
        "execution_authority": {"const": "none"},
        "account_access": {"const": "not-authorized"},
        "real_media_download": {"enum": ["not-applicable", "not-authorized", "explicit-only", "pending-user-validation"]},
        "boundary_note": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "formatRule": {
      "type": "object", "additionalProperties": false, "required": ["when", "choose", "adapter_ref", "reason"],
      "properties": {
        "when": {"type": "string", "minLength": 1},
        "choose": {"type": "string", "minLength": 1},
        "adapter_ref": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "ipRoute": {
      "type": "object", "additionalProperties": false,
      "required": ["account_ip", "primary_platforms", "primary_formats", "content_jobs", "cross_post_policy"],
      "properties": {
        "account_ip": {"type": "string", "minLength": 1},
        "primary_platforms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "primary_formats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "content_jobs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cross_post_policy": {"type": "string", "minLength": 1}
      }
    }
  }
}
