{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/self-media/short-video-timing-evidence.v1.schema.json",
  "title": "Short-video timing evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "generated_at", "artifact_status", "publication_boundary",
    "content_id", "stage", "synthetic_only", "input_binding", "script_binding",
    "timing_profile_binding", "story_design_binding", "media_binding", "measurement_basis", "duration_verification",
    "measured_duration_seconds", "observed_metrics", "continuity_result", "gate_result",
    "authority", "receipt_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "short-video-timing-evidence.v1"},
    "evidence_id": {"type": "string", "pattern": "^timing-evidence-[a-f0-9]{24}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifact_status": {"const": "candidate-only"},
    "publication_boundary": {"const": "manual-only"},
    "content_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "stage": {"enum": ["prerecording-script", "final-cut"]},
    "synthetic_only": {"type": "boolean"},
    "input_binding": {"$ref": "#/$defs/input_binding"},
    "script_binding": {"$ref": "#/$defs/artifact_ref"},
    "timing_profile_binding": {"$ref": "#/$defs/artifact_ref"},
    "story_design_binding": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]},
    "media_binding": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/media_ref"}]},
    "measurement_basis": {"enum": ["observed-read-aloud-timecode", "final-cut-timed-transcript"]},
    "duration_verification": {"enum": ["observed-read-aloud-timecode", "synthetic-fixture-declared", "ffprobe-observed"]},
    "measured_duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 900},
    "observed_metrics": {"$ref": "#/$defs/observed_metrics"},
    "continuity_result": {"$ref": "#/$defs/continuity_result"},
    "gate_result": {"const": "passed"},
    "authority": {"const": {"publish_authorized": false, "execution_authorized": false, "external_send_authorized": false}},
    "receipt_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safe_ref": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "path", "sha256"],
      "properties": {
        "owner": {"enum": ["self-media-creation-system", "content-studio-poc"]},
        "path": {"$ref": "#/$defs/safe_ref"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "media_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "path", "sha256", "duration_seconds", "media_copy_stored"],
      "properties": {
        "owner": {"const": "self-media-creation-system"},
        "path": {"$ref": "#/$defs/safe_ref"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 900},
        "media_copy_stored": {"const": false}
      }
    },
    "input_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "path", "sha256"],
      "properties": {
        "owner": {"const": "self-media-creation-system"},
        "path": {"$ref": "#/$defs/safe_ref"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observed_metrics": {
      "type": "object", "additionalProperties": false,
      "required": [
        "audience_stake_seconds", "reason_to_continue_seconds", "first_information_advance_seconds",
        "maximum_information_advance_gap_seconds", "information_advance_count",
        "main_payoff_seconds", "main_payoff_completion_ratio", "thresholds"
      ],
      "properties": {
        "audience_stake_seconds": {"type": "number", "minimum": 0},
        "reason_to_continue_seconds": {"type": "number", "minimum": 0},
        "first_information_advance_seconds": {"type": "number", "minimum": 0},
        "maximum_information_advance_gap_seconds": {"type": "number", "minimum": 0},
        "information_advance_count": {"type": "integer", "minimum": 1},
        "main_payoff_seconds": {"type": "number", "minimum": 0},
        "main_payoff_completion_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "thresholds": {"type": "object"}
      }
    },
    "continuity_result": {
      "type": "object", "additionalProperties": false,
      "required": ["surface_mode", "status", "timeline_entry_id"],
      "properties": {
        "surface_mode": {"enum": ["spoken", "caption", "profile-consistency", "not-surfaced-this-item"]},
        "status": {"enum": ["explicitly-delivered", "profile-only-not-spoken", "intentionally-not-surfaced"]},
        "timeline_entry_id": {"type": ["string", "null"], "pattern": "^beat-[0-9]{2,3}$"}
      }
    }
  }
}
